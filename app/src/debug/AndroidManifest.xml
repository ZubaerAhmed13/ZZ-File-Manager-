<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Debug-only deterministic DocumentsProvider used by API-35 instrumentation.
          Android's DocumentsProvider contract requires providers to be exported. This provider
          remains signature-permission protected, exists only in the debug target APK, and is
          absent from release builds. Production code never depends on it.
        -->
        <provider
            android:name="com.zz.filemanager.Step2TestDocumentsProvider"
            android:authorities="com.zz.filemanager.test.documents"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!--
          Debug-only synchronous test broker. It grants only the deterministic Step 2 tree and
          only to this app's instrumentation package, reproducing the narrow URI permission that
          system DocumentsUI issues after ACTION_OPEN_DOCUMENT_TREE selection. Release builds do
          not contain this component.
        -->
        <provider
            android:name="com.zz.filemanager.Step2SafGrantProvider"
            android:authorities="com.zz.filemanager.debug.safgrant"
            android:enabled="true"
            android:exported="true" />
    </application>
</manifest>
